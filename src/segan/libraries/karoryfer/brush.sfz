// Karoryfer Lecolds libraries brush: brush stirred on the snare (unpitched). Samples: Karoryfer Lecolds (Black And Green Guitars, Emily Guitar, Black And Blue Basses, D. Smolken double bass, Aliexpress Erhu, Swirly Drums), CC0 1.0 (https://github.com/sfzinstruments).
// Generated by scripts/make_karoryfer_library.py; sample paths are relative to the library's cache folder.
<control>
// volume: the median plain-velocity sample (loudest 400 ms) is -20 LUFS, its peak at most 0.7; dynamic layers keep their recorded levels.
<group> volume=6 ampeg_release=0.6 loop_mode=one_shot pitch_keytrack=0
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=1 hivel=31 seq_length=4 seq_position=1 sample=swirly/Samples/snare_stir/stir_dl1_rr1.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=1 hivel=31 seq_length=4 seq_position=2 sample=swirly/Samples/snare_stir/stir_dl1_rr2.wav
