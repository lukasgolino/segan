// NeoSoundFonts sets steel_guitar: old steel-string acoustic guitar. Samples: Simone Piervergili, NeoSoundFonts (Voice Oohs, Old Steel Guitar, Bamboo Flute), CC0 1.0 (https://github.com/NeoSoundFonts).
// Generated by scripts/make_neosound_library.py; sample paths are relative to the library's cache folder.
<control>
// volume: the median plain-velocity sample (loudest 400 ms) is -20 LUFS, its peak at most 0.7; dynamic layers keep their recorded levels.
<group> volume=-9.8 ampeg_release=0.4 tune=28 loop_mode=one_shot
<region> lokey=37 hikey=40 pitch_keycenter=40 lovel=1 hivel=127 sample=steel/samples/SteelGuitar 040.wav
