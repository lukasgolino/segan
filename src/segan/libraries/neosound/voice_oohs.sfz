<region> lokey=52 hikey=58 pitch_keycenter=55 lovel=1 hivel=127 seq_length=3 seq_position=2 sample=oohs/samples/Voice Oohs g3 rr2.wav
<region> lokey=52 hikey=58 pitch_keycenter=55 lovel=1 hivel=127 seq_length=3 seq_position=3 sample=oohs/samples/Voice Oohs g3 rr3.wav
<region> lokey=59 hikey=65 pitch_keycenter=62 lovel=1 hivel=127 seq_length=3 seq_position=1 sample=oohs/samples/Voice Oohs d4 rr1.wav
