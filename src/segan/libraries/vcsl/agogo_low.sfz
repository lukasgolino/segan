// Versilian Community Sample Library agogo_low: agogo bell, low (unpitched). Samples: Versilian Community Sample Library (VCSL), Versilian Studios, CC0 1.0 (https://github.com/sgossner/VCSL).
// Generated by scripts/make_vcsl_library.py; sample paths are relative to the library's cache folder.
<control>
// volume: the median plain-velocity sample (loudest 400 ms) is -20 LUFS, its peak at most 0.7; dynamic layers keep their recorded levels.
<group> volume=25.2 ampeg_release=0.4 loop_mode=one_shot pitch_keytrack=0
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=1 hivel=63 offset=288 sample=Idiophones/Struck Idiophones/Agogo Bells/Agogo_Low_v1_rr1_Mid.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=64 hivel=127 offset=288 sample=Idiophones/Struck Idiophones/Agogo Bells/Agogo_Low_v2_rr1_Mid.wav
