// Versilian Community Sample Library clap: hand claps, a group (unpitched). Samples: Versilian Community Sample Library (VCSL), Versilian Studios, CC0 1.0 (https://github.com/sgossner/VCSL).
// Generated by scripts/make_vcsl_library.py; sample paths are relative to the library's cache folder.
<control>
// volume: the median plain-velocity sample (loudest 400 ms) is -20 LUFS, its peak at most 0.7; dynamic layers keep their recorded levels.
<group> volume=-1.2 ampeg_release=0.2 loop_mode=one_shot pitch_keytrack=0
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=1 hivel=127 seq_length=6 seq_position=1 sample=Idiophones/Struck Idiophones/Claps/Clap_rr1.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=1 hivel=127 seq_length=6 seq_position=2 sample=Idiophones/Struck Idiophones/Claps/Clap_rr2.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=1 hivel=127 seq_length=6 seq_position=3 sample=Idiophones/Struck Idiophones/Claps/Clap_rr3.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=1 hivel=127 seq_length=6 seq_position=4 sample=Idiophones/Struck Idiophones/Claps/Clap_rr4.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=1 hivel=127 seq_length=6 seq_position=5 sample=Idiophones/Struck Idiophones/Claps/Clap_rr5.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=1 hivel=127 seq_length=6 seq_position=6 sample=Idiophones/Struck Idiophones/Claps/Clap_rr6.wav
