// Versilian Community Sample Library hihat_open: hi-hat, open (unpitched). Samples: Versilian Community Sample Library (VCSL), Versilian Studios, CC0 1.0 (https://github.com/sgossner/VCSL).
// Generated by scripts/make_vcsl_library.py; sample paths are relative to the library's cache folder.
<control>
// volume: the median plain-velocity sample (loudest 400 ms) is -20 LUFS, its peak at most 0.7; dynamic layers keep their recorded levels.
<group> volume=4 ampeg_release=0.6 loop_mode=one_shot pitch_keytrack=0
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=1 hivel=127 seq_length=2 seq_position=1 offset=281 sample=Idiophones/Struck Idiophones/Hi-Hat Cymbal/HiHat_HitO_rr1_Mid.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=1 hivel=127 seq_length=2 seq_position=2 offset=281 sample=Idiophones/Struck Idiophones/Hi-Hat Cymbal/HiHat_HitO_rr2_Mid.wav
