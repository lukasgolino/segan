// Versilian Community Sample Library slit_drum_low: slit (log) drum, low (unpitched). Samples: Versilian Community Sample Library (VCSL), Versilian Studios, CC0 1.0 (https://github.com/sgossner/VCSL).
// Generated by scripts/make_vcsl_library.py; sample paths are relative to the library's cache folder.
<control>
// volume: the median plain-velocity sample (loudest 400 ms) is -20 LUFS, its peak at most 0.7; dynamic layers keep their recorded levels.
<group> volume=19.1 ampeg_release=0.3 loop_mode=one_shot pitch_keytrack=0
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=1 hivel=42 sample=Idiophones/Struck Idiophones/Slit Drum/LogDrumLo_MedM_v1_rr1_Sum.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=43 hivel=84 sample=Idiophones/Struck Idiophones/Slit Drum/LogDrumLo_MedM_v2_rr1_Sum.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=85 hivel=127 sample=Idiophones/Struck Idiophones/Slit Drum/LogDrumLo_MedM_v3_rr1_Sum.wav
