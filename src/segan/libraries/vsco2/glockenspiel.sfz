// VSCO 2 CE glockenspiel: glockenspiel. Samples: Versilian Studios Chamber Orchestra 2 Community Edition (VSCO-2-CE), CC0 1.0 (https://github.com/sgossner/VSCO-2-CE, commit 440300901dfe).
// Generated by scripts/make_vsco2_library.py; sample paths are relative to the repository root.
<control>
// volume: the median sample (loudest 400 ms) is -20 LUFS; dynamic layers keep their recorded levels.
<group> volume=21.5 ampeg_release=0.6 loop_mode=one_shot
<region> lokey=76 hikey=81 pitch_keycenter=79 lovel=1 hivel=127 sample=Percussion/Glock/glock_medium_G4.wav
<region> lokey=82 hikey=87 pitch_keycenter=84 lovel=1 hivel=127 sample=Percussion/Glock/glock_medium_C5.wav
<region> lokey=88 hikey=93 pitch_keycenter=91 lovel=1 hivel=127 offset=207 sample=Percussion/Glock/glock_medium_G5.wav
<region> lokey=94 hikey=99 pitch_keycenter=96 lovel=1 hivel=127 sample=Percussion/Glock/glock_medium_C6.wav
<region> lokey=100 hikey=105 pitch_keycenter=103 lovel=1 hivel=127 sample=Percussion/Glock/glock_medium_G6.wav
<region> lokey=106 hikey=111 pitch_keycenter=108 lovel=1 hivel=127 offset=207 sample=Percussion/Glock/glock_medium_C7.wav
