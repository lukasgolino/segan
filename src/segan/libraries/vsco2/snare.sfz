// VSCO 2 CE snare: concert snare, snares on (unpitched). Samples: Versilian Studios Chamber Orchestra 2 Community Edition (VSCO-2-CE), CC0 1.0 (https://github.com/sgossner/VSCO-2-CE, commit 440300901dfe).
// Generated by scripts/make_vsco2_library.py; sample paths are relative to the repository root.
<control>
// volume: the median sample (loudest 400 ms) is -20 LUFS; dynamic layers keep their recorded levels.
<group> volume=18.2 ampeg_release=0.3 loop_mode=one_shot pitch_keytrack=0
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=1 hivel=25 seq_length=2 seq_position=1 sample=Percussion/Snare2-HitSN_v1_rr1_Sum.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=1 hivel=25 seq_length=2 seq_position=2 sample=Percussion/Snare2-HitSN_v1_rr2_Sum.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=26 hivel=50 seq_length=2 seq_position=1 sample=Percussion/Snare2-HitSN_v3_rr1_Sum.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=26 hivel=50 seq_length=2 seq_position=2 sample=Percussion/Snare2-HitSN_v3_rr2_Sum.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=51 hivel=76 seq_length=2 seq_position=1 sample=Percussion/Snare2-HitSN_v5_rr1_Sum.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=51 hivel=76 seq_length=2 seq_position=2 sample=Percussion/Snare2-HitSN_v5_rr2_Sum.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=77 hivel=101 seq_length=2 seq_position=1 sample=Percussion/Snare2-HitSN_v7_rr1_Sum.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=77 hivel=101 seq_length=2 seq_position=2 sample=Percussion/Snare2-HitSN_v7_rr2_Sum.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=102 hivel=127 seq_length=2 seq_position=1 sample=Percussion/Snare2-HitSN_v9_rr1_Sum.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=102 hivel=127 seq_length=2 seq_position=2 sample=Percussion/Snare2-HitSN_v9_rr2_Sum.wav
