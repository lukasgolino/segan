// VSCO 2 CE sus_cymbal: suspended cymbal, stick (unpitched). Samples: Versilian Studios Chamber Orchestra 2 Community Edition (VSCO-2-CE), CC0 1.0 (https://github.com/sgossner/VSCO-2-CE, commit 440300901dfe).
// Generated by scripts/make_vsco2_library.py; sample paths are relative to the repository root.
<control>
// volume: the median sample (loudest 400 ms) is -20 LUFS; dynamic layers keep their recorded levels.
<group> volume=20 ampeg_release=1 loop_mode=one_shot pitch_keytrack=0
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=1 hivel=31 seq_length=2 seq_position=1 sample=Percussion/susCymb1-hitstick_pp_rr1.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=1 hivel=31 seq_length=2 seq_position=2 sample=Percussion/susCymb1-hitstick_pp_rr2.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=32 hivel=63 seq_length=2 seq_position=1 sample=Percussion/susCymb1-hitstick_mp_rr1.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=32 hivel=63 seq_length=2 seq_position=2 sample=Percussion/susCymb1-hitstick_mp_rr2.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=64 hivel=95 seq_length=2 seq_position=1 sample=Percussion/susCymb1-hitstick_f_rr1.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=64 hivel=95 seq_length=2 seq_position=2 sample=Percussion/susCymb1-hitstick_f_rr2.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=96 hivel=127 seq_length=2 seq_position=1 sample=Percussion/susCymb1-hitstick_fff_rr1.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=96 hivel=127 seq_length=2 seq_position=2 sample=Percussion/susCymb1-hitstick_fff_rr2.wav
