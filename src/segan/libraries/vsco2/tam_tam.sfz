// VSCO 2 CE tam_tam: tam-tam / gong (unpitched). Samples: Versilian Studios Chamber Orchestra 2 Community Edition (VSCO-2-CE), CC0 1.0 (https://github.com/sgossner/VSCO-2-CE, commit 440300901dfe).
// Generated by scripts/make_vsco2_library.py; sample paths are relative to the repository root.
<control>
// volume: the median sample (loudest 400 ms) is -20 LUFS; dynamic layers keep their recorded levels.
<group> volume=1 ampeg_release=2 loop_mode=one_shot pitch_keytrack=0
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=1 hivel=31 sample=Percussion/gongHit_p.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=32 hivel=63 offset=987 sample=Percussion/gongHit_mf.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=64 hivel=95 offset=1580 sample=Percussion/gongHit_f.wav
<region> lokey=0 hikey=127 pitch_keycenter=60 lovel=96 hivel=127 offset=1099 sample=Percussion/gongHit_fff.wav
