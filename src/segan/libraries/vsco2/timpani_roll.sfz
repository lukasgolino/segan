// VSCO 2 CE timpani_roll: timpani, rolls. Samples: Versilian Studios Chamber Orchestra 2 Community Edition (VSCO-2-CE), CC0 1.0 (https://github.com/sgossner/VSCO-2-CE, commit 440300901dfe).
// Generated by scripts/make_vsco2_library.py; sample paths are relative to the repository root.
<control>
// volume: the median sample (loudest 400 ms) is -20 LUFS; dynamic layers keep their recorded levels.
<group> volume=15.2 ampeg_release=0.5 loop_mode=one_shot
<region> lokey=40 hikey=45 pitch_keycenter=43 lovel=1 hivel=42 sample=Percussion/Timpani/Rolls/Timpani1_Roll_v3_rr1_Sum.wav
<region> lokey=46 hikey=48 pitch_keycenter=47 lovel=1 hivel=42 sample=Percussion/Timpani/Rolls/Timpani2_Roll_v3_rr1_Sum.wav
<region> lokey=49 hikey=50 pitch_keycenter=49 lovel=1 hivel=42 sample=Percussion/Timpani/Rolls/Timpani3_Roll_v3_rr1_Sum.wav
<region> lokey=51 hikey=53 pitch_keycenter=52 lovel=1 hivel=42 sample=Percussion/Timpani/Rolls/Timpani4_Roll_v3_rr1_Sum.wav
<region> lokey=54 hikey=58 pitch_keycenter=55 lovel=1 hivel=42 sample=Percussion/Timpani/Rolls/Timpani5_Roll_v3_rr1_Sum.wav
<region> lokey=52 hikey=58 pitch_keycenter=55 lovel=43 hivel=84 sample=Percussion/Timpani/Rolls/Timpani5_Roll_v4_rr1_Sum.wav
<region> lokey=40 hikey=45 pitch_keycenter=43 lovel=85 hivel=127 sample=Percussion/Timpani/Rolls/Timpani1_Roll_v5_rr1_Sum.wav
